# Copy to .env and fill in. Never commit .env.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

# PostgreSQL 18 on this machine listens on port 5433 (PostgreSQL 15 uses 5432).
DATABASE_URL=postgres://videototext:change-me@localhost:5433/videototext

# ALLOWED_HOSTS=localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Live pipeline
# VIDEO_DIR=media/videos            # files clients may stream
# ALLOW_WEBCAM=True
# TORCH_DEVICE=cpu                  # cuda on a GPU machine
# VLM_MODEL=HuggingFaceTB/SmolVLM2-256M-Video-Instruct
# COMMENTARY_INTERVAL=3
# STREAM_MAX_WIDTH=640
# STREAM_JPEG_QUALITY=70
